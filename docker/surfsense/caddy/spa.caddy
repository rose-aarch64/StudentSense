# The SPA, built into the image; any path it routes itself falls back to index.html.
handle {
	root * {$SURFSENSE_FRONTEND_DIR}

	# A build's files are named by content hash, so one that exists never changes and
	# is kept for good. Everything else, the page above all, is checked on every load:
	# the page names the current build, so a new build reaches the browser without a
	# hard reload. A script that does not exist falls back to the page below, which
	# must not be kept under that script's name, so only files that exist are kept.
	@built {
		path /assets/*
		file {path}
	}
	header @built Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
